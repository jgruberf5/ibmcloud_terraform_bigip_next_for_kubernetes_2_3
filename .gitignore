# ─── Terraform ──────────────────────────────────────────────
# State files may contain secrets and infra-specific identifiers.
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*

# Per-project working directory (terraform init populates this).
.terraform/
.terraform.lock.hcl
.terraform-provider-cache/

# tfvars contain the IBM Cloud API key and other secrets.
terraform.tfvars
terraform.tfvars.bak

# `bnk plan` writes this short-lived plan file and removes it on
# success; ignore so a crash mid-flow doesn't leak it into a commit.
.bnk-plan.tfplan

# ─── bnk runtime artifacts in cwd ───────────────────────────
# When bnk runs, these land in the current directory because /work
# is bind-mounted to $(pwd) and HOME is set to /work.
.kube/
.bluemix/
.terraform.d/

# `run_tests.sh` (= `bnk infra test`) output tree.
test-runs/
test-reports/

# IBM Cloud provider kubeconfig downloads (cluster auth tokens).
*_k8sconfig/

# ─── Local environment / shell helpers ──────────────────────
.env
.env.*
make_dot_envs.sh

# ─── Editors / IDEs ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ─── Claude Code session data ───────────────────────────────
.claude/

# ─── OS ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
