#!/usr/bin/env bash
# ============================================================
# bnk — unified CLI for the ibmcloud-terraform-bnk-2-3 runner image
#
# Single verb-noun command surface for the docker-based workflow:
# wraps `docker run` of the runner image and the in-container
# cloud-exec helper so users learn one command, get tab completion,
# and `bnk doctor` tells them why something is broken.
#
# Common:
#   bnk init                     interactive tfvars wizard
#   bnk install                  copy bnk to /dest (run inside the image)
#   bnk uninstall                remove bnk (and optionally state/image)
#   bnk doctor                   preflight: docker, image, tfvars, IBM Cloud auth
#   bnk status [--drift]         one-screen: auth, tfstate, cluster, workloads
#   bnk plan                     terraform plan with module-grouped summary
#   bnk apply [--auto]           terraform apply (--auto for non-interactive)
#   bnk destroy                  terraform destroy
#   bnk delete [--force]         remove .bnk/ from cwd (after typed confirm)
#   bnk teardown                 destroy + delete in one shot
#   bnk shell                    interactive cluster shell (cloud-exec)
#   bnk kubectl ... | oc ...     one-shot cluster commands
#
# Groups:
#   bnk infra <init|plan|apply|destroy|delete|output|test>
#   bnk cluster <shell|kubectl|oc|ibmcloud|info>
#   bnk exec <cmd...>            arbitrary command in container
#
# Completion:
#   source <(bnk completion bash)          # bash
#   source <(bnk completion zsh)           # zsh
#
# Env overrides:
#   IMAGE   image ref (default: ghcr.io/jgruberf5/ibmcloud-terraform-bnk-2-3:latest)
#
# State model:
#   The current directory is bind-mounted at /work inside the container.
#   terraform.tfvars (your input) sits at the top of cwd; everything
#   bnk owns — tfstate, terraform's internals, kubeconfig, ibmcloud
#   session, plan files, test runs — lives under .bnk/ in cwd. Run bnk
#   from a per-project directory; don't share one cwd across unrelated
#   deployments. Wipe a project with `bnk delete` (= `rm -rf .bnk`).
# ============================================================
set -euo pipefail

IMAGE="${IMAGE:-ghcr.io/jgruberf5/ibmcloud-terraform-bnk-2-3:latest}"

# Where the Terraform project lives inside the image. terraform commands
# use -chdir=$TF_PROJECT_DIR so they read .tf files from here, while
# state, var-file, and TF_DATA_DIR all point at /work (host cwd).
TF_PROJECT_DIR=/opt/tf-project

# bnk's working subdirectory inside the user's cwd. Everything bnk
# owns — terraform state, .terraform internals, kubeconfig, ibmcloud
# session, plan files, test runs — lives under here so the user's cwd
# stays clean. One ignore pattern (`.bnk/`) covers all of it.
BNK_DIR=.bnk

# ── tty / color helpers ─────────────────────────────────────
if [[ -t 1 ]]; then
    C_OK=$'\e[32m'; C_FAIL=$'\e[31m'; C_WARN=$'\e[33m'
    C_DIM=$'\e[90m'; C_BOLD=$'\e[1m'; C_OFF=$'\e[0m'
    SYM_OK="✓"; SYM_FAIL="✗"; SYM_WARN="!"
else
    C_OK=""; C_FAIL=""; C_WARN=""; C_DIM=""; C_BOLD=""; C_OFF=""
    SYM_OK="OK"; SYM_FAIL="FAIL"; SYM_WARN="WARN"
fi
ok()      { printf "  %s%s%s %s\n"  "$C_OK"   "$SYM_OK"   "$C_OFF" "$*"; }
fail()    { printf "  %s%s%s %s\n"  "$C_FAIL" "$SYM_FAIL" "$C_OFF" "$*"; }
warn()    { printf "  %s%s%s %s\n"  "$C_WARN" "$SYM_WARN" "$C_OFF" "$*"; }
hint()    { printf "    %s↳ %s%s\n" "$C_DIM"  "$*" "$C_OFF"; }
section() { printf "\n%s%s%s\n"     "$C_BOLD" "$*" "$C_OFF"; }

# ── docker plumbing ─────────────────────────────────────────
need_tfvars() {
    [[ -f "$(pwd)/terraform.tfvars" ]] || {
        echo "bnk: terraform.tfvars not found in $(pwd)" >&2
        echo "  run: bnk init" >&2
        exit 1
    }
}
# Pull the runner image once, lazily, so a freshly-installed bnk works
# without a separate `docker pull`. Stays quiet on subsequent runs.
ensure_image() {
    docker image inspect "$IMAGE" >/dev/null 2>&1 && return 0
    printf "bnk: image %s not found locally — pulling...\n" "$IMAGE" >&2
    docker pull "$IMAGE" >&2
}

# Common docker run args:
#   --user $UID:$GID       files written to /work land owned by the
#                          host user (without this, root-in-container
#                          writes root-owned files in the host cwd)
#   -v $(pwd):/work        host cwd is /work — terraform.tfvars sits
#                          at /work, everything else under /work/.bnk
#   -e HOME=/work/.bnk     ibmcloud (.bluemix) and kubectl ($HOME/.kube)
#                          drop their caches under .bnk by default
#   -e TF_DATA_DIR=...     terraform's working dir lives at .bnk/terraform
#   -e KUBECONFIG=...      pinned so cloud-exec and bnk agree on the
#                          path even when HOME isn't read
docker_args=(
    --user "$(id -u):$(id -g)"
    -v "$(pwd):/work"
    -e HOME=/work/.bnk
    -e TF_DATA_DIR=/work/.bnk/terraform
    -e KUBECONFIG=/work/.bnk/.kube/config
)

# Forward IBM Cloud credentials and region from host env into the
# container if the user has them set. Lets users skip the API key in
# terraform.tfvars when their shell already has it (CI runners,
# personal dev setups, `ibmcloud login` sessions, etc.). Order is
# informational — the entrypoint normalises whichever is set into
# IBMCLOUD_API_KEY before exec'ing the user's command.
BNK_ENV_PASSTHROUGH=(
    IBMCLOUD_API_KEY
    IC_API_KEY
    IBMCLOUD_REGION
    TF_VAR_ibmcloud_api_key
    TF_VAR_ibmcloud_cluster_region
    TF_VAR_IBMCLOUD_API_KEY
    TF_VAR_IC_API_KEY
)
for _v in "${BNK_ENV_PASSTHROUGH[@]}"; do
    if [[ -n "${!_v:-}" ]]; then
        docker_args+=(-e "$_v=${!_v}")
    fi
done
unset _v

# First non-empty env var from BNK_ENV_PASSTHROUGH that holds an API
# key (region vars get filtered). Returns "" if nothing is set.
host_api_key() {
    local v
    for v in IBMCLOUD_API_KEY IC_API_KEY \
             TF_VAR_ibmcloud_api_key \
             TF_VAR_IBMCLOUD_API_KEY TF_VAR_IC_API_KEY; do
        if [[ -n "${!v:-}" ]]; then
            printf '%s\t%s' "${!v}" "$v"
            return
        fi
    done
}

ensure_workspace() {
    mkdir -p "$BNK_DIR"
}
docker_run() {
    ensure_image
    ensure_workspace
    docker run -it --rm "${docker_args[@]}" "$IMAGE" "$@"
}
# Non-interactive variant for probes — no -it, no stdin attached.
docker_run_quiet() {
    ensure_image
    ensure_workspace
    docker run --rm "${docker_args[@]}" "$IMAGE" "$@"
}

# All terraform invocations from bnk go through this so the -chdir,
# -state, -var-file, and TF_DATA_DIR knobs stay consistent. Pass the
# subcommand and any extra args; this prepends -chdir.
tf() {
    local sub=$1; shift
    docker_run terraform -chdir="$TF_PROJECT_DIR" "$sub" "$@"
}

# Lazy `terraform init` for the user's cwd. The image ships a
# pre-warmed plugin cache at /opt/tf-project/.terraform-provider-cache
# (TF_PLUGIN_CACHE_DIR is set in the image's ENV), so init creates
# symlinks into the cache rather than downloading providers — fast
# and offline. Skips when .terraform/providers is already present.
ensure_tf_init() {
    [[ -d "$(pwd)/$BNK_DIR/terraform/providers" ]] && return 0
    printf "%sbnk: initialising terraform in $(pwd)/.bnk (one-time)...%s\n" \
        "$C_DIM" "$C_OFF" >&2
    # docker_run_quiet (no -it) — init is fully non-interactive with
    # -input=false and runs cleanly in CI / piped contexts too.
    docker_run_quiet terraform -chdir="$TF_PROJECT_DIR" \
        init -input=false -no-color >/dev/null
}

read_tfvar() {
    awk -F'"' "/^[[:space:]]*$1[[:space:]]*=/{print \$2; exit}" terraform.tfvars
}

# Are we running INSIDE the runner image? (vs. on the host)
# /opt/tf-project is created at build time and never exists on a host
# install — safe distinguisher.
is_in_container() {
    [[ -f /opt/tf-project/bnk && -f /opt/tf-project/docker-entrypoint.sh ]]
}

# ── install / uninstall ─────────────────────────────────────
# Two flavours, dispatched on whether we're inside the image:
#
#   On host (rare — host bnk installs via install.sh):
#     `bnk install`   prints how to install (install.sh / docker run)
#     `bnk uninstall` removes the host bnk + optionally volume + image
#
#   Inside the image (the airgap install path):
#     docker run --rm -v "$HOME/.local/bin:/dest" $IMAGE bnk install
#       copies /opt/tf-project/bnk → /dest/bnk and chmods +x.
#     `bnk uninstall` (in-container) just removes /dest/bnk.

cmd_install() {
    if ! is_in_container; then
        local self
        self=$(realpath "$0" 2>/dev/null || echo "$0")
        cat <<EOF
bnk is already installed at $self.

To install on a different host, choose one:

  Online:
    curl -fsSL https://raw.githubusercontent.com/jgruberf5/ibmcloud_terraform_bigip_next_for_kubernetes_2_3/main/install.sh | bash

  Airgap (image already on disk):
    docker run --rm -v "\$HOME/.local/bin:/dest" $IMAGE bnk install
EOF
        return 0
    fi
    if [[ ! -d /dest ]]; then
        cat >&2 <<EOF
bnk install: /dest is not mounted.

Mount your bin dir at /dest:
  docker run --rm -v "\$HOME/.local/bin:/dest" $IMAGE bnk install
EOF
        exit 1
    fi
    cp /opt/tf-project/bnk /dest/bnk
    chmod +x /dest/bnk
    cat <<EOF
✓ bnk installed to /dest/bnk

Make sure /dest's mount target is on your host PATH. Typically:
    export PATH="\$HOME/.local/bin:\$PATH"

Then:
    bnk doctor
    bnk init
EOF
}

cmd_uninstall() {
    if is_in_container; then
        if [[ -f /dest/bnk ]]; then
            rm -f /dest/bnk
            echo "✓ bnk removed from /dest/bnk"
        else
            echo "bnk: nothing at /dest/bnk to remove"
        fi
        return 0
    fi

    # Host path
    local self
    self=$(realpath "$0" 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0")

    cat <<EOF

This will:
  1. Remove bnk from $self
  2. Optionally remove the docker image '$IMAGE'

Per-project state lives in each project's directory under .bnk/. To
wipe a project's state, run 'bnk delete' inside that directory.

EOF

    local ans
    printf "Remove bnk from %s? [y/N]: " "$self"
    read -r ans
    [[ "$ans" =~ ^[Yy] ]] || { echo "aborted."; return 1; }

    printf "Also remove docker image %s? [y/N]: " "$IMAGE"
    read -r ans
    if [[ "$ans" =~ ^[Yy] ]]; then
        if docker image rm "$IMAGE" 2>/dev/null; then
            ok "removed image $IMAGE"
        else
            warn "image $IMAGE not present"
        fi
    fi

    rm -f "$self"
    echo "✓ uninstalled."
}

# Drop a .gitignore in the user's cwd that protects them from
# committing secrets and runtime caches. Idempotent: bracketed by a
# marker so a re-run of `bnk init` skips the section if it's already
# there. Users are free to add their own entries above the block.
write_user_gitignore() {
    local marker_begin="# === bnk runtime — do not commit ==="
    local marker_end="# === end bnk ==="
    if [[ -f .gitignore ]] && grep -qF "$marker_begin" .gitignore; then
        ok ".gitignore already protects bnk runtime files"
        return 0
    fi
    {
        # Separate from any existing content so the block is readable.
        [[ -f .gitignore && -s .gitignore ]] && printf '\n'
        cat <<'GITIGNORE_BLOCK'
# === bnk runtime — do not commit ===
# `bnk init` wrote this section. These files contain secrets:
#   - terraform.tfvars   your IBM Cloud API key
#   - .bnk/              terraform state, kubeconfig, ibmcloud session
# Committing them would expose your infrastructure. Add your own
# ignores ABOVE this block; the next `bnk init` keeps this section
# intact when it sees the marker.
terraform.tfvars
terraform.tfvars.bak
.bnk/
# === end bnk ===
GITIGNORE_BLOCK
    } >> .gitignore
    ok ".gitignore written (protects tfvars, tfstate, .kube, .bluemix)"
}

# ── init wizard ─────────────────────────────────────────────
# Interactive tfvars builder. Runs on the host, prompts for the
# variables most likely to need overrides, validates the API key
# against the chosen region, then copies the full
# terraform.tfvars.example out of the image into the cwd and patches
# the prompted values in place — so the user gets a fully-commented
# tfvars with every variable visible (not just the 7 we asked about).
cmd_init() {
    if [[ -f terraform.tfvars ]]; then
        printf "terraform.tfvars already exists in %s\n" "$(pwd)"
        printf "Overwrite (existing → terraform.tfvars.bak)? [y/N]: "
        local ans; read -r ans
        [[ "$ans" =~ ^[Yy] ]] || { echo "aborted."; return 1; }
        mv terraform.tfvars terraform.tfvars.bak
    fi

    section "bnk init — interactive tfvars wizard"

    local api_key region rg create_roks cluster_name workers ocp_ver

    # Prompt with default; pass "secret" as 4th arg to suppress echo.
    # `mode=${4:-}` lets callers omit the 4th arg under `set -u`.
    ask() {
        local label=$1 default=$2 var=$3 mode=${4:-} input
        if [[ "$mode" == secret ]]; then
            printf "  %-30s: " "$label"
            read -r -s input; echo
        elif [[ -n "$default" ]]; then
            printf "  %-30s [%s]: " "$label" "$default"
            read -r input
            input=${input:-$default}
        else
            printf "  %-30s: " "$label"
            read -r input
        fi
        printf -v "$var" "%s" "$input"
    }

    # If the user already has an API key in their env, skip the prompt
    # (with confirmation). Saves typing and reduces the chance of a
    # mistyped paste.
    local _hk _hk_var
    _hk=$(host_api_key)
    if [[ -n "$_hk" ]]; then
        _hk_var="${_hk#*	}"
        printf "  IBM Cloud API key found in \$%s (%d chars). Use it? [Y/n]: " \
            "$_hk_var" "$(( ${#_hk} - ${#_hk_var} - 1 ))"
        local _ans; read -r _ans
        if [[ ! "$_ans" =~ ^[Nn] ]]; then
            api_key="${_hk%	*}"
        fi
    fi
    if [[ -z "$api_key" ]]; then
        ask "IBM Cloud API key"    ""                     api_key  secret
        [[ -z "$api_key" ]] && { fail "API key is required"; return 1; }
    fi
    ask "Region"                   "ca-tor"               region
    ask "Resource group"           "default"              rg
    ask "Create new ROKS cluster"  "y"                    create_roks
    ask "Cluster name"             "tf-openshift-cluster" cluster_name
    ask "Workers per zone"         "1"                    workers
    ask "OpenShift version"        "4.18"                 ocp_ver

    local create_bool=true
    [[ "$create_roks" =~ ^[Yy] ]] || create_bool=false

    section "Validating API key against $region"
    ensure_image
    if docker run --rm --entrypoint "" \
            -e "API_KEY=$api_key" -e "REGION=$region" \
            "$IMAGE" \
            sh -c 'ibmcloud login --apikey "$API_KEY" -r "$REGION"' \
            >/dev/null 2>&1; then
        ok "API key works in $region"
    else
        fail "ibmcloud login failed for region '$region'"
        hint "verify the api key value and region code, then re-run"
        return 1
    fi

    section "Writing terraform.tfvars"
    # Step 1: drop the in-image example onto the host. --user keeps the
    # resulting file owned by the host user (otherwise root inside the
    # container writes a root-owned file, leaving the user needing sudo
    # to edit it later). --entrypoint "" skips the entrypoint's symlink
    # / init dance — we just need a single cp.
    if ! docker run --rm --entrypoint "" \
            --user "$(id -u):$(id -g)" \
            -v "$(pwd):/work" \
            "$IMAGE" \
            cp /opt/tf-project/terraform.tfvars.example /work/terraform.tfvars \
            2>/dev/null; then
        fail "could not extract terraform.tfvars.example from $IMAGE"
        return 1
    fi

    # Step 2: patch the prompted values in place. awk's `sub(/=.*/, ...)`
    # replaces only the value half of the matching line, preserving any
    # trailing comment is NOT preserved on purpose — terraform.tfvars.example
    # rarely has trailing comments, and keeping them would require a
    # more elaborate parser.
    patch_var() {
        local key=$1 value=$2 quoted=$3 val
        if [[ "$quoted" == yes ]]; then val="\"$value\""; else val="$value"; fi
        awk -v key="$key" -v val="$val" '
            $0 ~ "^[[:space:]]*"key"[[:space:]]*=[[:space:]]*" {
                sub(/=.*/, "= " val)
            }
            { print }
        ' terraform.tfvars > terraform.tfvars.tmp \
            && mv terraform.tfvars.tmp terraform.tfvars
    }

    patch_var ibmcloud_api_key          "$api_key"      yes
    patch_var ibmcloud_cluster_region   "$region"       yes
    patch_var ibmcloud_resource_group   "$rg"           yes
    patch_var create_roks_cluster       "$create_bool"  no
    patch_var openshift_cluster_name    "$cluster_name" yes
    patch_var openshift_cluster_version "$ocp_ver"      yes
    patch_var roks_workers_per_zone     "$workers"      no

    chmod 600 terraform.tfvars
    ok "terraform.tfvars written ($(wc -l < terraform.tfvars) lines, all variables included)"

    write_user_gitignore

    # Offer to wire up shell completion. Detects $SHELL; skips silently
    # for unsupported shells. Default Yes; user can decline.
    section "Shell completion"
    local _sh="${SHELL##*/}"
    case "$_sh" in
        bash|zsh)
            local _rc="$HOME/.${_sh}rc"
            if [[ -f "$_rc" ]] && grep -qF "# === bnk completion ===" "$_rc"; then
                ok "$_rc already sources bnk completion"
            else
                printf "  Detected %s. Add bnk tab-completion to %s? [Y/n]: " \
                    "$_sh" "$_rc"
                local _ans; read -r _ans
                if [[ ! "$_ans" =~ ^[Nn] ]]; then
                    install_shell_completion
                else
                    hint "skipped — install later with: bnk completion install"
                fi
            fi
            ;;
        *)
            warn "shell '$_sh' not bash or zsh — skipping completion install"
            hint "for bash/zsh users: bnk completion install"
            ;;
    esac

    section "Next steps"
    printf "  %sReview:%s  \$EDITOR terraform.tfvars\n" "$C_BOLD" "$C_OFF"
    printf "  %sPlan:%s    bnk plan\n"                  "$C_BOLD" "$C_OFF"
    printf "  %sApply:%s   bnk apply\n"                 "$C_BOLD" "$C_OFF"
}

# ── doctor ──────────────────────────────────────────────────
cmd_doctor() {
    local failures=0

    section "Host environment"
    if command -v docker >/dev/null 2>&1; then
        ok "docker present ($(docker --version | awk '{print $3}' | tr -d ,))"
    else
        fail "docker not found"; hint "install Docker Desktop or docker-ce"
        return 1
    fi
    if docker info >/dev/null 2>&1; then
        ok "docker daemon reachable"
    else
        fail "docker daemon unreachable"; hint "start Docker / 'sudo systemctl start docker'"
        return 1
    fi
    if docker image inspect "$IMAGE" >/dev/null 2>&1; then
        local created age_days
        created=$(docker image inspect -f '{{.Created}}' "$IMAGE")
        # Compute age inside the container so we don't need GNU date on
        # the host (BSD `date` lacks -d). jq's `fromdate` parses the
        # docker timestamp once we strip its fractional seconds. Falls
        # back to a no-age message if jq isn't in the image yet (older
        # build pre-dating the jq apk add).
        age_days=$(docker run --rm --entrypoint "" \
            -e "CREATED=$created" "$IMAGE" \
            jq -nr 'env.CREATED | sub("\\.[0-9]+"; "") | fromdate as $t
                    | (now - $t) / 86400 | floor' 2>/dev/null) || age_days=""
        if [[ -z "$age_days" ]]; then
            ok "image $IMAGE present"
        elif (( age_days > 30 )); then
            warn "image $IMAGE is ${age_days}d old"
            hint "rebuild: docker build -t $IMAGE ."
        else
            ok "image $IMAGE present (${age_days}d old)"
        fi
    else
        fail "image $IMAGE not built"
        hint "docker build -t $IMAGE ."
        failures=$((failures+1))
    fi
    if [[ -w . ]]; then
        ok "current directory writable ($(pwd))"
    else
        fail "current directory not writable: $(pwd)"
        hint "bnk uses the cwd as its workspace — pick a writable dir"
        failures=$((failures+1))
    fi

    section "Project files"
    if [[ -f terraform.tfvars ]]; then
        ok "terraform.tfvars present"
    else
        fail "terraform.tfvars missing"
        hint "run: bnk init"
        failures=$((failures+1))
        printf "\n%s%d check(s) failed.%s\n" "$C_FAIL" "$failures" "$C_OFF"
        return 1
    fi
    local api_key api_key_source region
    api_key=$(read_tfvar ibmcloud_api_key)
    api_key_source="terraform.tfvars"
    region=$(read_tfvar ibmcloud_cluster_region)

    # If tfvars doesn't have the key (or has a placeholder), try host
    # env vars before failing — bnk forwards these into the container.
    if [[ -z "$api_key" || "$api_key" == "YOUR_"* || "$api_key" == "REPLACE_ME"* ]]; then
        local _hk
        _hk=$(host_api_key)
        if [[ -n "$_hk" ]]; then
            api_key="${_hk%	*}"
            api_key_source="\$${_hk#*	}"
        fi
    fi

    if [[ -n "$api_key" && "$api_key" != "YOUR_"* && "$api_key" != "REPLACE_ME"* ]]; then
        ok "ibmcloud_api_key set (${#api_key} chars from $api_key_source)"
    else
        fail "ibmcloud_api_key not in tfvars and no env var set"
        hint "set one of: IBMCLOUD_API_KEY, IC_API_KEY, TF_VAR_ibmcloud_api_key"
        hint "  or run: bnk init"
        failures=$((failures+1))
    fi
    if [[ -n "$region" ]]; then
        ok "ibmcloud_cluster_region = $region"
    else
        warn "ibmcloud_cluster_region not set, will default to ca-tor"
    fi

    section "Container probes"
    if (( failures > 0 )); then
        warn "skipping container probes due to earlier failures"
        printf "\n%s%d check(s) failed.%s\n" "$C_FAIL" "$failures" "$C_OFF"
        return 1
    fi
    # Single container invocation runs every in-container check at once.
    # Output lines are key=rc pairs the host parses; stderr is suppressed
    # because login chatter ("API endpoint: ..." etc.) is not useful here.
    local probe
    probe=$(docker_run_quiet bash -c '
        set +e
        ibmcloud login --apikey "$IBMCLOUD_API_KEY" -r "$IBMCLOUD_REGION" >/dev/null 2>&1
        echo "IBM_LOGIN=$?"
        # Validate against the image-baked .terraform (pre-warmed by
        # `terraform init` at build time) — not against TF_DATA_DIR
        # which points at /work/.bnk/terraform and is empty on a fresh
        # project dir.
        TF_DATA_DIR=/opt/tf-project/.terraform \
            terraform -chdir=/opt/tf-project validate -no-color >/dev/null 2>&1
        echo "TF_VALIDATE=$?"
    ' 2>/dev/null) || true

    if grep -q '^IBM_LOGIN=0$' <<<"$probe"; then
        ok "ibmcloud login succeeds (region=$region)"
    else
        fail "ibmcloud login failed"
        hint "verify ibmcloud_api_key and ibmcloud_cluster_region"
        failures=$((failures+1))
    fi
    if grep -q '^TF_VALIDATE=0$' <<<"$probe"; then
        ok "terraform validate passes"
    else
        warn "terraform validate failed"
    fi

    section "Shell completion"
    local _sh="${SHELL##*/}"
    case "$_sh" in
        bash|zsh)
            local _rc="$HOME/.${_sh}rc"
            if [[ -f "$_rc" ]] && grep -qF "# === bnk completion ===" "$_rc"; then
                ok "$_rc sources bnk completion"
            else
                warn "no bnk completion in $_rc"
                hint "install: bnk completion install"
            fi
            ;;
        *)
            warn "shell '$_sh' not bash or zsh — completion install not supported"
            ;;
    esac

    section "Summary"
    if (( failures == 0 )); then
        printf "  %sAll checks passed.%s Try '%sbnk plan%s' next.\n" \
            "$C_OK" "$C_OFF" "$C_BOLD" "$C_OFF"
        return 0
    fi
    printf "  %s%d check(s) failed.%s\n" "$C_FAIL" "$failures" "$C_OFF"
    return 1
}

# ── plan with summary ───────────────────────────────────────
# `terraform plan -out` saves the binary plan; we then run
# `terraform show -no-color` on it (a fast, offline second pass)
# and pipe the human plan through a bash summarizer that groups
# resource changes by top-level module. The user sees the normal
# coloured plan output live; the summary is appended after.
cmd_plan() {
    need_tfvars
    ensure_tf_init
    docker_run bash -c '
        set -e

        summarize() {
            declare -A counts groups totals
            local line addr action_text a g p1 p2 _
            while IFS= read -r line; do
                [[ "$line" =~ ^"  # "(.+)" will be "(.+)$ ]] || continue
                addr=${BASH_REMATCH[1]}
                action_text=${BASH_REMATCH[2]}
                case "$action_text" in
                    created*)   a=add ;;
                    destroyed*) a=del ;;
                    replaced*)  a=rep ;;
                    updated*)   a=chg ;;
                    *)          continue ;;
                esac
                if [[ "$addr" == module.* ]]; then
                    IFS=. read -r p1 p2 _ <<<"$addr"
                    g="$p1.$p2"
                else
                    g="<root>"
                fi
                counts[$g/$a]=$(( ${counts[$g/$a]:-0} + 1 ))
                groups[$g]=1
                totals[$a]=$(( ${totals[$a]:-0} + 1 ))
            done

            local OK=$(printf "\e[32m") WARN=$(printf "\e[33m")
            local FAIL=$(printf "\e[31m") BOLD=$(printf "\e[1m") OFF=$(printf "\e[0m")
            printf "\n%s── plan summary ──────────────────────────────────────%s\n" "$BOLD" "$OFF"
            if (( ${#groups[@]} == 0 )); then
                printf "  no resource changes\n"
                return
            fi
            printf "  %-40s  %s%4s%s %s%4s%s %s%4s%s %s%4s%s\n" "module" \
                "$OK" "+add" "$OFF" "$WARN" "~chg" "$OFF" \
                "$FAIL" "-del" "$OFF" "$FAIL" "±rep" "$OFF"
            local g
            while IFS= read -r g; do
                printf "  %-40s  %4d %4d %4d %4d\n" "$g" \
                    "${counts[$g/add]:-0}" "${counts[$g/chg]:-0}" \
                    "${counts[$g/del]:-0}" "${counts[$g/rep]:-0}"
            done < <(printf "%s\n" "${!groups[@]}" | sort)
            printf "  %s%-40s  %4d %4d %4d %4d%s\n" "$BOLD" "TOTAL" \
                "${totals[add]:-0}" "${totals[chg]:-0}" \
                "${totals[del]:-0}" "${totals[rep]:-0}" "$OFF"
        }

        plan_file=/work/.bnk/plan.tfplan
        terraform -chdir=/opt/tf-project plan \
            -state=/work/.bnk/terraform.tfstate \
            -var-file=/work/terraform.tfvars \
            -out="$plan_file" "$@"
        terraform -chdir=/opt/tf-project show -no-color "$plan_file" | summarize
        rm -f "$plan_file"
    ' -- "$@"
}

# ── status ──────────────────────────────────────────────────
# One-screen dashboard: IBM Cloud auth, terraform state freshness,
# cluster health, and BIG-IP-NEXT-specific namespace pod counts.
# Runs inside a single docker_run so cloud-exec's login/kubeconfig
# cache is hit at most once. All parsing is bash + grep/cut — no
# awk scripts, since this script body lives inside an outer
# single-quoted bash -c heredoc.
cmd_status() {
    local check_drift=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --drift) check_drift=true; shift ;;
            -h|--help)
                echo "Usage: bnk status [--drift]"
                echo "  --drift   refresh state against IBM Cloud and report drift (slow)"
                return 0 ;;
            *) echo "bnk status: unknown option '$1'" >&2; return 1 ;;
        esac
    done
    need_tfvars
    [[ "$check_drift" == true ]] && ensure_tf_init
    docker_run bash -c '
        set +e

        CHECK_DRIFT=$1

        BOLD=$(printf "\e[1m");  DIM=$(printf "\e[90m")
        OK=$(printf "\e[32m");   WARN=$(printf "\e[33m")
        FAIL=$(printf "\e[31m"); OFF=$(printf "\e[0m")

        section() { printf "\n%s%s%s\n" "$BOLD" "$1" "$OFF"; }
        kv() { printf "  %-14s  %s\n" "$1" "$2"; }

        read_tfvar() {
            local key=$1 line
            while IFS= read -r line; do
                if [[ "$line" =~ ^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\"([^\"]*)\" ]]; then
                    printf "%s" "${BASH_REMATCH[1]}"
                    return
                fi
            done < /work/terraform.tfvars
        }

        printf "%sgathering status...%s\n" "$DIM" "$OFF" >&2

        # Cloud-exec covers both ibmcloud login and kubeconfig fetch; if it
        # exits clean we know auth + cluster are reachable for the cluster
        # and workloads sections. ibmcloud login alone (without kubeconfig)
        # is enough for the IBM Cloud section, so we tolerate cloud-exec
        # failure and fall back to a direct login.
        CLUSTER_OK=false; CLUSTER=""
        if cloud-exec true >/dev/null 2>&1; then
            CLUSTER_OK=true
            CLUSTER=$(cat "$KUBECONFIG.cluster-id" 2>/dev/null)
        else
            ibmcloud login --apikey "$IBMCLOUD_API_KEY" -r "$IBMCLOUD_REGION" >/dev/null 2>&1
        fi

        section "IBM Cloud"
        kv region "$IBMCLOUD_REGION"
        ACCT=$(ibmcloud account show 2>/dev/null \
            | grep -iE "^Account[[:space:]]+(Name|ID):" \
            | head -1 | cut -d: -f2- | xargs)
        [[ -n "$ACCT" ]] && kv account "$ACCT"

        section "Terraform"
        if [[ -f /work/.bnk/terraform.tfstate ]]; then
            N=$(terraform -chdir=/opt/tf-project state list \
                    -state=/work/.bnk/terraform.tfstate 2>/dev/null | wc -l)
            MTIME=$(stat -c %Y /work/.bnk/terraform.tfstate)
            AGE_MIN=$(( ( $(date +%s) - MTIME ) / 60 ))
            if   (( AGE_MIN <   60 )); then AGE="${AGE_MIN}m"
            elif (( AGE_MIN < 1440 )); then AGE="$((AGE_MIN/60))h"
            else                            AGE="$((AGE_MIN/1440))d"
            fi
            kv state "$N resources, ${AGE} since last write"
            if [[ "$CHECK_DRIFT" == true ]]; then
                printf "  %schecking drift...%s\r" "$DIM" "$OFF" >&2
                terraform -chdir=/opt/tf-project plan -refresh-only -detailed-exitcode \
                    -input=false -no-color -lock=false \
                    -state=/work/.bnk/terraform.tfstate \
                    -var-file=/work/terraform.tfvars \
                    >/dev/null 2>&1
                DRIFT_RC=$?
                printf "                            \r" >&2
                case $DRIFT_RC in
                    0) kv drift "${OK}none${OFF}" ;;
                    2) kv drift "${WARN}detected${OFF} — run: bnk plan -refresh-only" ;;
                    *) kv drift "${DIM}check failed${OFF}" ;;
                esac
            fi
        else
            kv state "${DIM}no state yet${OFF} — run: bnk plan && bnk apply"
        fi

        if $CLUSTER_OK; then
            section "Cluster  $CLUSTER"
            CINFO=$(ibmcloud ks cluster get --cluster "$CLUSTER" 2>/dev/null)
            for FIELD in "State:state" "Master Status:masters" \
                         "Master Version:version" "Ingress Subdomain:ingress" \
                         "Workers:workers"; do
                K=${FIELD%%:*}; LABEL=${FIELD##*:}
                V=$(printf "%s" "$CINFO" | grep "^${K}:" | head -1 | cut -d: -f2- | xargs)
                [[ -n "$V" ]] && kv "$LABEL" "$V"
            done

            NT=$(kubectl get nodes --no-headers 2>/dev/null | wc -l)
            NR=$(kubectl get nodes --no-headers 2>/dev/null | grep -c " Ready ")
            if (( NT > 0 )); then
                if (( NR == NT )); then C=$OK; else C=$WARN; fi
                kv nodes "${C}${NR}/${NT} Ready${OFF}"
            fi

            section "Workloads"
            FOUND=0
            for VAR in flo_namespace flo_utils_namespace cert_manager_namespace; do
                NS=$(read_tfvar "$VAR")
                [[ -z "$NS" ]] && continue
                FOUND=1
                T=$(kubectl -n "$NS" get pods --no-headers 2>/dev/null | wc -l)
                if (( T == 0 )); then
                    kv "$NS" "${DIM}no pods${OFF}"
                    continue
                fi
                R=$(kubectl -n "$NS" get pods --no-headers 2>/dev/null \
                    | grep -cE " (Running|Completed) ")
                if (( R == T )); then C=$OK; else C=$WARN; fi
                kv "$NS" "${C}${R}/${T}${OFF}"
            done
            (( FOUND == 0 )) && kv "(none)" "${DIM}no namespace tfvars set${OFF}"
        else
            section "Cluster"
            kv state "${DIM}not reachable${OFF} — try: bnk doctor"
        fi

        echo
    ' -- "$check_drift"
}

# ── completion ──────────────────────────────────────────────
cmd_completion() {
    local shell="${1:-}"
    local body
    body=$(cat <<'COMPLETION_EOF'
_bnk_complete() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local top="init install uninstall doctor status infra cluster plan apply destroy delete teardown output test kubectl oc ibmcloud shell exec completion help"
    local infra_subs="init plan apply destroy delete output test help"
    local cluster_subs="shell kubectl oc ibmcloud info help"
    case "$COMP_CWORD" in
        1) COMPREPLY=( $(compgen -W "$top" -- "$cur") ) ;;
        2)
            case "${COMP_WORDS[1]}" in
                infra)      COMPREPLY=( $(compgen -W "$infra_subs"   -- "$cur") ) ;;
                cluster)    COMPREPLY=( $(compgen -W "$cluster_subs" -- "$cur") ) ;;
                completion) COMPREPLY=( $(compgen -W "bash zsh"      -- "$cur") ) ;;
            esac ;;
    esac
}
complete -F _bnk_complete bnk
COMPLETION_EOF
)
    case "$shell" in
        bash) printf '%s\n' "$body" ;;
        zsh)  printf 'autoload -U +X bashcompinit && bashcompinit\n%s\n' "$body" ;;
        install) install_shell_completion ;;
        *)
            cat >&2 <<'EOF'
Usage: bnk completion <bash|zsh>     # print script to stdout
       bnk completion install        # detect shell, hook into rc file

Bash:  source <(bnk completion bash)
       (or persist: bnk completion install)

Zsh:   source <(bnk completion zsh)
EOF
            exit 1 ;;
    esac
}

# Detect $SHELL, append a `source <(bnk completion ...)` block to the
# user's rc file inside an idempotent marker. Re-running is a no-op
# once installed. The guard `command -v bnk` keeps the rc file from
# emitting "command not found" if bnk is later uninstalled.
install_shell_completion() {
    local sh rc
    sh="${SHELL##*/}"
    case "$sh" in
        bash) rc="$HOME/.bashrc" ;;
        zsh)  rc="$HOME/.zshrc"  ;;
        *)
            fail "shell '$sh' not bash or zsh (\$SHELL=$SHELL)"
            hint "manually source: source <(bnk completion bash)"
            return 1 ;;
    esac

    local marker_begin="# === bnk completion ==="
    if [[ -f "$rc" ]] && grep -qF "$marker_begin" "$rc"; then
        ok "$rc already sources bnk completion"
        return 0
    fi
    {
        [[ -f "$rc" && -s "$rc" ]] && printf '\n'
        cat <<COMPLETION_BLOCK
$marker_begin
# Loads $sh completion for the bnk CLI. Managed by 'bnk completion
# install' — remove this block to disable. The 'command -v bnk' guard
# prevents 'command not found' noise if bnk is later removed.
command -v bnk >/dev/null && source <(bnk completion $sh)
# === end bnk completion ===
COMPLETION_BLOCK
    } >> "$rc"
    ok "appended bnk completion to $rc"
    hint "open a new shell, or run: source $rc"
}

# ── infra ───────────────────────────────────────────────────
cmd_infra() {
    local sub="${1:-help}"; shift || true
    case "$sub" in
        help|"") cat <<'EOF'
bnk infra <subcommand>
  init                  terraform init
  plan                  terraform plan with module-grouped summary
  apply [--auto]        terraform apply (--auto adds -auto-approve)
  destroy               terraform destroy
  output [name]         terraform output
  test [args...]        run the 4-scenario test harness (writes to ./test-runs/)
  delete                remove .bnk/ from cwd (state, kubeconfig, session)
EOF
            return 0 ;;
        delete) cmd_delete "$@"; return $? ;;
    esac
    need_tfvars
    # Standard flags every plan/apply/destroy needs: read state from
    # /work/.bnk/terraform.tfstate (cwd/.bnk), read inputs from
    # /work/terraform.tfvars (cwd root). -chdir points terraform at the
    # in-image project tree.
    local STATE=-state=/work/.bnk/terraform.tfstate
    local VARFILE=-var-file=/work/terraform.tfvars
    case "$sub" in
        init)    tf init "$@" ;;
        plan)    cmd_plan "$@" ;;
        apply)
            ensure_tf_init
            # --auto is a bnk-only flag; everything else passes through.
            local auto=()
            local rest=()
            for a in "$@"; do
                if [[ "$a" == --auto ]]; then auto=(-auto-approve)
                else rest+=("$a")
                fi
            done
            tf apply "$STATE" "$VARFILE" "${auto[@]}" "${rest[@]}"
            ;;
        destroy) ensure_tf_init; tf destroy "$STATE" "$VARFILE" "$@" ;;
        output)  ensure_tf_init; tf output  "$STATE" "$@" ;;
        test)    docker_run /opt/tf-project/run_tests.sh "$@" ;;
        *) echo "bnk infra: unknown subcommand '$sub'" >&2; exit 1 ;;
    esac
}

# ── delete ──────────────────────────────────────────────────
# Removes the .bnk/ directory in the cwd. terraform.tfvars is the only
# bnk-relevant file outside .bnk/ and is left alone (user-edited input).
# Refuses by default if terraform.tfstate lists provisioned resources
# (so users don't orphan a live cluster); --force overrides.
cmd_delete() {
    local force=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force|-f) force=true; shift ;;
            -h|--help)
                echo "Usage: bnk delete [--force]"
                echo "  --force   skip the 'tfstate has provisioned resources' guard"
                return 0 ;;
            *) echo "bnk delete: unknown option '$1'" >&2; return 1 ;;
        esac
    done

    if [[ ! -d "$BNK_DIR" ]]; then
        echo "bnk delete: no $BNK_DIR/ in $(pwd) — nothing to do."
        return 0
    fi

    # Guard: if the state file has any managed resources, deleting
    # local state would orphan whatever's running in IBM Cloud. grep
    # against the json is faster than a `terraform state list` round-
    # trip and stays correct for any resource type.
    if [[ "$force" != true \
        && -f "$BNK_DIR/terraform.tfstate" \
        && -s "$BNK_DIR/terraform.tfstate" ]] \
       && grep -q '"mode": "managed"' "$BNK_DIR/terraform.tfstate"; then
        cat >&2 <<EOF

bnk delete: refusing — terraform.tfstate lists provisioned resources.

If you delete .bnk/ now, whatever is running in IBM Cloud will be
orphaned: the cluster keeps billing and you lose the ability to manage
or remove it from this directory.

Recommended:
  bnk destroy        # tear down the infrastructure first
  bnk delete         # then clear local state

Or do both in one shot:
  bnk teardown

Or, if you really mean "drop local state and leave the cloud alone":
  bnk delete --force

EOF
        return 1
    fi

    cat <<EOF

This will permanently delete $(pwd)/$BNK_DIR/, which holds:

  - terraform.tfstate                 (cluster + VPC + TGW records)
  - terraform/ (TF_DATA_DIR)          (provider links, module cache)
  - .kube/config                      (cluster admin kubeconfig)
  - .bluemix/                         (ibmcloud session and plugins)
  - test-runs/                        (per-run state from 'bnk infra test')

terraform.tfvars is left alone.

If you have a live cluster provisioned by this state, run 'bnk destroy'
first — otherwise the cluster will keep running but you will lose the
ability to manage it from here.

EOF
    printf "Type 'delete' to confirm: "
    local ans; read -r ans
    if [[ "$ans" != "delete" ]]; then
        echo "aborted."
        return 1
    fi
    rm -rf "$BNK_DIR"
    ok "removed $BNK_DIR/"
}

# ── teardown ────────────────────────────────────────────────
# `bnk destroy` followed by `bnk delete` in a single command. Single
# typed confirmation up front, then runs terraform destroy
# -auto-approve and removes .bnk/ on success. If destroy fails .bnk/
# is preserved so the user can inspect logs and retry.
cmd_teardown() {
    if [[ ! -d "$BNK_DIR" ]]; then
        echo "bnk teardown: no $BNK_DIR/ in $(pwd) — nothing to do."
        echo "  (run 'bnk apply' first if you need to provision)"
        return 0
    fi
    need_tfvars
    cat <<EOF

This will run, in order:

  1. bnk destroy   — terraform destroy every resource in tfstate
  2. bnk delete    — remove $(pwd)/$BNK_DIR/ (local state + caches)

If destroy fails, .bnk/ is preserved so you can inspect logs and
retry. terraform.tfvars is left alone in either case.

EOF
    printf "Type 'teardown' to confirm: "
    local ans; read -r ans
    if [[ "$ans" != "teardown" ]]; then
        echo "aborted."
        return 1
    fi

    section "Destroying infrastructure"
    ensure_tf_init
    if ! tf destroy -auto-approve \
            -state=/work/.bnk/terraform.tfstate \
            -var-file=/work/terraform.tfvars; then
        fail "destroy failed — $BNK_DIR/ preserved for retry"
        return 1
    fi
    ok "destroy complete"

    section "Removing local state"
    rm -rf "$BNK_DIR"
    ok "removed $BNK_DIR/"
}

# ── cluster ─────────────────────────────────────────────────
cmd_cluster() {
    local sub="${1:-shell}"; shift || true
    case "$sub" in
        help) cat <<'EOF'
bnk cluster <subcommand>
  shell                interactive cloud-exec shell (default)
  kubectl ...          one-shot kubectl with cluster auth
  oc ...               one-shot oc
  ibmcloud ...         one-shot ibmcloud
  info                 cluster + node summary
EOF
            return 0 ;;
    esac
    need_tfvars
    case "$sub" in
        shell)               docker_run cloud-exec "$@" ;;
        kubectl|oc|ibmcloud) docker_run cloud-exec "$sub" "$@" ;;
        info)
            docker_run cloud-exec bash -c '
                set -e
                echo "── cluster ──"
                ibmcloud ks cluster get --cluster "$(cat "$KUBECONFIG.cluster-id")" 2>/dev/null \
                    | grep -E "^(Name|State|Master Status|Ingress|Workers|Version):"
                echo
                echo "── nodes ──"
                kubectl get nodes
            ' ;;
        *) echo "bnk cluster: unknown subcommand '$sub'" >&2; exit 1 ;;
    esac
}

# ── top-level dispatch ──────────────────────────────────────
CMD="${1:-help}"; shift || true
case "$CMD" in
    init)                 cmd_init      "$@" ;;
    install)              cmd_install   "$@" ;;
    uninstall)            cmd_uninstall "$@" ;;
    doctor)               cmd_doctor    "$@" ;;
    status)               cmd_status    "$@" ;;
    infra)                cmd_infra   "$@" ;;
    cluster)              cmd_cluster "$@" ;;

    # Short aliases for the common flows — `bnk plan` → `bnk infra plan`.
    plan|apply|destroy|delete|output|test)
                          cmd_infra   "$CMD" "$@" ;;
    teardown)             cmd_teardown "$@" ;;
    kubectl|oc|ibmcloud)  cmd_cluster "$CMD" "$@" ;;
    shell)                cmd_cluster shell "$@" ;;

    exec)                 need_tfvars; docker_run "$@" ;;
    completion)           cmd_completion "$@" ;;

    -h|--help|help)
        sed -n '2,/^[^#]/{/^#/!q; s/^# \{0,2\}//p}' "$0" ;;
    *)
        echo "bnk: unknown command '$CMD' — see 'bnk help'" >&2
        exit 1 ;;
esac
