#!/usr/bin/env bash
# ============================================================
# cloud-exec — fetch the project's ROKS cluster kubeconfig and either
#              run a command or drop into an interactive bash.
#
# IBMCLOUD_API_KEY / IBMCLOUD_REGION / KUBECONFIG are exported by
# docker-entrypoint.sh from env vars or /work/terraform.tfvars; this
# script just discovers the cluster and drives `ibmcloud login` +
# `ibmcloud ks cluster config`.
#
# Cluster lookup order:
#   - -c <cluster> argument
#   - terraform output -raw roks_cluster_id (post-apply)
#   - roks_cluster_id_or_name (when create_roks_cluster=false)
#   - openshift_cluster_name  (when create_roks_cluster=true)
#
# The kubeconfig is cached at $KUBECONFIG and re-fetched only if
# missing, older than 30 minutes, or pointing at a different cluster.
#
# Usage:
#   cloud-exec                            # interactive shell
#   cloud-exec kubectl get pods -A        # one-shot command
#   cloud-exec -c my-cluster oc whoami    # override cluster lookup
# ============================================================
set -euo pipefail

TFVARS=/work/terraform.tfvars

read_tfvar() {
    [[ -f "$TFVARS" ]] || return 0
    awk -F'"' "/^[[:space:]]*$1[[:space:]]*=/{print \$2; exit}" "$TFVARS"
}

# `terraform output -raw NAME` against a state with zero outputs prints the
# "No outputs found" warning to *stdout* (not stderr) and exits 0, so the
# diagnostic leaks past 2>/dev/null and becomes the captured value. -json
# errors cleanly in that case; we strip the surrounding quotes here.
tf_output_str() {
    local raw
    raw=$(terraform output -json "$1" 2>/dev/null) || return 0
    [[ "$raw" =~ ^\"(.*)\"$ ]] && printf '%s' "${BASH_REMATCH[1]}"
}

# ── Arg parsing ─────────────────────────────────────────────
CLUSTER_OVERRIDE=""
while [[ $# -gt 0 && "$1" == -* ]]; do
    case "$1" in
        -c|--cluster) shift; CLUSTER_OVERRIDE="${1:-}"; shift || true ;;
        --)           shift; break ;;
        -h|--help)    sed -n '2,/^[^#]/{/^#/!q; s/^# \{0,2\}//p}' "$0"; exit 0 ;;
        *)            break ;;
    esac
done

# ── Decide what setup is actually needed ────────────────────
# The default cloud-exec path is "log in, fetch kubeconfig, then run
# the command" — appropriate for kubectl/oc and the interactive
# shell. For `ibmcloud help|--help|version|-v|config ...` we don't
# need a login (the command is local) and definitely don't need a
# kubeconfig. Skipping setup avoids tripping `ibmcloud login`'s
# interactive update prompt and avoids failing the kubeconfig fetch
# when the cluster doesn't yet exist (e.g. pre-apply for the
# create_roks_cluster=true path).
needs_login=true
needs_kubeconfig=true
if [[ "${1:-}" == "ibmcloud" ]]; then
    # ibmcloud commands never need cloud-exec's kubeconfig prefetch —
    # the user invoking ibmcloud directly is bootstrapping or doing
    # IBM Cloud admin, not running cluster ops.
    needs_kubeconfig=false
    case "${2:-}" in
        ""|--help|-h|help|--version|-v|version|config)
            needs_login=false
            ;;
    esac
fi

# ── Credentials sanity check ────────────────────────────────
# The entrypoint should have set these.  If they are still missing
# the user mounted no tfvars and passed no env vars; fail loudly.
if [[ "$needs_login" == "true" ]]; then
    [[ -n "${IBMCLOUD_API_KEY:-}" ]] || {
        echo "cloud-exec: IBMCLOUD_API_KEY not set." >&2
        echo "  Provide -e TF_VAR_ibmcloud_api_key=... or bind-mount terraform.tfvars at /work/." >&2
        exit 1
    }
fi
: "${IBMCLOUD_REGION:=ca-tor}"
export KUBECONFIG="${KUBECONFIG:-/work/.kube/config}"
mkdir -p "$(dirname "$KUBECONFIG")"

# ── Cluster discovery ───────────────────────────────────────
CLUSTER="$CLUSTER_OVERRIDE"
if [[ "$needs_kubeconfig" == "true" ]]; then
    [[ -z "$CLUSTER" ]] && CLUSTER=$(tf_output_str roks_cluster_id)
    [[ -z "$CLUSTER" ]] && CLUSTER=$(read_tfvar roks_cluster_id_or_name)
    [[ -z "$CLUSTER" ]] && CLUSTER=$(read_tfvar openshift_cluster_name)
    [[ -n "$CLUSTER" ]] || {
        echo "cloud-exec: cluster not found." >&2
        echo "  Pass -c <name>, run after terraform apply, or set roks_cluster_id_or_name" >&2
        echo "  / openshift_cluster_name in $TFVARS." >&2
        exit 1
    }
fi

# ── Login + kubeconfig (cached in volume) ───────────────────
# IBM Cloud IAM bearer tokens last ~1h; refresh after 50 min so kubectl
# never trips a 401 inside the cache window.  A sidecar marker file
# records which cluster id the cached kubeconfig was fetched for —
# the kubeconfig YAML stores the human cluster name, not the id, so
# we cannot reliably grep $CLUSTER against the file itself.
TOKEN_TTL=3000
MARKER="$KUBECONFIG.cluster-id"

need_refresh=true
if [[ "$needs_kubeconfig" != "true" ]]; then
    need_refresh=false
elif [[ -s "$KUBECONFIG" && -f "$MARKER" ]] \
   && (( $(date +%s) - $(stat -c %Y "$KUBECONFIG") < TOKEN_TTL )) \
   && [[ "$(cat "$MARKER" 2>/dev/null)" == "$CLUSTER" ]]; then
    need_refresh=false
fi

if [[ "$needs_login" == "true" && "$needs_kubeconfig" != "true" ]]; then
    # ibmcloud subcommand needs auth but no kubeconfig (e.g.
    # `ibmcloud account list`, `ibmcloud target -g foo`). Login
    # lazily so the IBM API call from the user's command has a
    # session. Quiet redirect — the user's own command will produce
    # their requested output.
    ibmcloud login --apikey "$IBMCLOUD_API_KEY" -r "$IBMCLOUD_REGION" >/dev/null
fi

if [[ "$need_refresh" == true ]]; then
    echo "cloud-exec: ibmcloud login (region=$IBMCLOUD_REGION)..." >&2
    # --apikey passed explicitly so login is unambiguously non-interactive.
    # Output is NOT redirected — any prompt or error surfaces immediately
    # instead of silently hanging on stdin.
    ibmcloud login --apikey "$IBMCLOUD_API_KEY" -r "$IBMCLOUD_REGION"

    echo "cloud-exec: fetching kubeconfig (cluster=$CLUSTER)..." >&2
    # `ibmcloud ks cluster config --admin` writes the kubeconfig to
    # $HOME/.kube/config; KUBECONFIG is unset in the subshell so it
    # lands at the default path regardless of our pinned export.
    DEFAULT_KUBE="${HOME:-/root}/.kube/config"
    ( unset KUBECONFIG; ibmcloud ks cluster config --cluster "$CLUSTER" --admin )
    [[ -f "$DEFAULT_KUBE" ]] || {
        echo "cloud-exec: kubeconfig not produced at $DEFAULT_KUBE" >&2
        exit 1
    }
    cp "$DEFAULT_KUBE" "$KUBECONFIG"
    chmod 600 "$KUBECONFIG"
    printf '%s' "$CLUSTER" > "$MARKER"
fi

# ── Hand off ────────────────────────────────────────────────
if [[ $# -eq 0 ]]; then
    exec bash --rcfile <(cat <<EOF
[[ -f /etc/profile ]]    && source /etc/profile
[[ -f \$HOME/.bashrc ]]  && source \$HOME/.bashrc
PS1='(cloud-exec:$CLUSTER) \$ '
echo "Cluster=$CLUSTER  Region=$IBMCLOUD_REGION  KUBECONFIG=$KUBECONFIG"
echo "ibmcloud / kubectl / oc are ready."
EOF
)
else
    exec "$@"
fi
